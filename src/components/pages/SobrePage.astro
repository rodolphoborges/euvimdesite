---
import Base from '../../layouts/Base.astro';
import Social from '../Social.astro';
import { site, videos } from '../../lib/data.mjs';
import { href } from '../../lib/format.mjs';
import { t } from '../../lib/i18n.mjs';
const { locale = 'pt' } = Astro.props;
const T = (k: string, v?: Record<string, string>) => t(locale, k, v);
const canalYT = (site.social?.canal || [])[0];
const autorRedes = site.social?.autor || [];
---
<Base title={T('sobre_title')} desc={T('sobre_desc')} nav="sobre" locale={locale}>
  <div class="wrap page prose">
    <header class="page-h"><h1>{T('sobre_h1')}</h1><p>{T('site_tagline')}</p></header>
    <p set:html={T('sobre_p1', { n: site.name, a: site.author, h: site.authorHandle, v: String(videos.length) })} />
    <h2>{T('sobre_h2_ed')}</h2>
    <ul>
      <li set:html={T('ed_taticas')} />
      <li set:html={T('ed_comentarios')} />
      <li set:html={T('ed_noticias')} />
      <li set:html={T('ed_lives')} />
      <li set:html={T('ed_entrevistas')} />
    </ul>
    <h2>{T('sobre_h2_how')}</h2>
    <p>{T('how_p1')}</p>
    <p>{T('how_p2')}</p>
    <h2>{T('sobre_h2_apoie')}</h2>
    <p>
      <a class="btn btn-gold" href={`https://www.youtube.com/${site.channelHandle}?sub_confirmation=1`} target="_blank" rel="noopener">{T('subscribe')}</a>
      <a class="btn" href={site.membersUrl} target="_blank" rel="noopener">{T('btn_member')}</a>
      <a class="btn" href={href('canais/', locale)}>{T('btn_canais')}</a>
    </p>
    <h2>{T('sobre_h2_fol')}</h2>
    <p>{T('fol_p')}</p>
    <p>
      {canalYT && <Social item={canalYT} btn gold />}
      {autorRedes.map(s => <Social item={s} btn />)}
    </p>
    {site.social?.contato && <p>{T('fol_contact')} <a href={`mailto:${site.social.contato}`}>{site.social.contato}</a></p>}
    <h2 id="remocao">{T('sobre_h2_legal')}</h2>
    <p set:html={T('legal_p', { u: site.repoUrl })} />
  </div>
</Base>
