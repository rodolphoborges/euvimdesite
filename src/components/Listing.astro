---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import ShortCard from './ShortCard.astro';
import Pager from './Pager.astro';
import { catList, tv } from '../lib/data.mjs';
import { href } from '../lib/format.mjs';
import { t, catName } from '../lib/i18n.mjs';
const { page, cat = '', title, intro, basePath, locale = 'pt' } = Astro.props;
const items = page.data.map(v => tv(locale, v));
const chips = [['', t(locale, 'chips_all'), href('videos/', locale)], ...catList.map(c => [c, catName(locale, c), href(`categoria/${c}/`, locale)])];
const pageTitle = page.currentPage > 1 ? `${title} — ${t(locale, 'page_of')} ${page.currentPage}` : title;
---
<Base title={pageTitle} desc={t(locale, 'list_desc', { t: title })} nav={cat === 'lives' ? 'lives' : 'videos'} locale={locale}>
  <div class="wrap page">
    <header class="page-h"><h1>{title}</h1><p>{intro}</p></header>
    <nav class="chips" aria-label={t(locale, 'chips_label')}>
      {chips.map(([k, label, h]) => <a href={h} aria-current={k === cat ? 'page' : undefined}>{label}</a>)}
    </nav>
    {page.data.length === 0 && <p class="vazio">{t(locale, 'list_empty')}</p>}
    {cat === 'shorts'
      ? <div class="grid-shorts">{items.map(v => <ShortCard v={v} locale={locale} />)}</div>
      : <div class="grid">{items.map((v, i) => <Card v={v} eager={i < 4} locale={locale} />)}</div>}
    <Pager page={page} basePath={basePath} locale={locale} />
  </div>
</Base>
