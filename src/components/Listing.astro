---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import ShortCard from './ShortCard.astro';
import Pager from './Pager.astro';
import { catList, CATS } from '../lib/data.mjs';
import { href } from '../lib/format.mjs';
const { page, cat = '', title, intro, basePath } = Astro.props;
const chips = [['', 'Tudo', href('videos/')], ...catList.map(c => [c, CATS[c], href(`categoria/${c}/`)])];
const pageTitle = page.currentPage > 1 ? `${title} — página ${page.currentPage}` : title;
---
<Base title={pageTitle} desc={`${title}: vídeos do canal Eu Vim de Santos.`} nav={cat === 'lives' ? 'lives' : 'videos'}>
  <div class="wrap page">
    <header class="page-h"><h1>{title}</h1><p>{intro}</p></header>
    <nav class="chips" aria-label="Editorias">
      {chips.map(([k, label, h]) => <a href={h} aria-current={k === cat ? 'page' : undefined}>{label}</a>)}
    </nav>
    {page.data.length === 0 && <p class="vazio">Nada por aqui ainda.</p>}
    {cat === 'shorts'
      ? <div class="grid-shorts">{page.data.map(v => <ShortCard v={v} />)}</div>
      : <div class="grid">{page.data.map((v, i) => <Card v={v} eager={i < 4} />)}</div>}
    <Pager page={page} basePath={basePath} />
  </div>
</Base>
