---
import { thumbHq, ytUrl } from '../lib/format.mjs';
import { t } from '../lib/i18n.mjs';
const { v, eager = false, locale = 'pt' } = Astro.props;
---
<div class="player" data-id={v.id} data-title={v.title}>
  <a class="lite" href={ytUrl(v)} target="_blank" rel="noopener" aria-label={t(locale, 'player_watch', { t: v.title })}>
    <img src={thumbHq(v.id)} alt="" width="480" height="360" fetchpriority={eager ? 'high' : undefined} loading={eager ? undefined : 'lazy'} decoding="async">
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3" fill="#e0ab1f"/><path d="M45 24 27 14v20" fill="#0b0b0f"/></svg>
  </a>
</div>
