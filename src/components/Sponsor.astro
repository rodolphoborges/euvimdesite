---
// Card de patrocinador. variant: "full" (página de parceiros, com QR) ou "mini" (home e vídeo).
import { qr } from '../lib/sponsors.mjs';
import { href } from '../lib/format.mjs';
const { p, variant = 'full', showVideos = false } = Astro.props;
const svg = variant === 'full' ? await qr(p.link) : '';
const logo = p.logo ? (/^https?:/.test(p.logo) ? p.logo : href(p.logo)) : '';
const accent = /^#[0-9a-f]{6}$/i.test(p.cor || '') ? p.cor : '#e0ab1f';
// texto escuro sobre cores claras, branco sobre escuras (contraste do botão)
const [r, g, b] = [1, 3, 5].map(i => parseInt(accent.slice(i, i + 2), 16) / 255).map(c => c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const onAccent = 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.3 ? '#0b0b0f' : '#ffffff';
---
<article class={`sp sp-${variant}`} style={`--sp:${accent};--sp-tx:${onAccent}`}>
  <header class="sp-h">
    {logo ? <img class="sp-logo" src={logo} alt="" width="44" height="44" loading="lazy"> : <span class="sp-logo sp-mono" aria-hidden="true">{p.nome.slice(0, 1)}</span>}
    <div>
      <p class="sp-tag">Publicidade{p.desconto && <span> · {p.desconto}</span>}</p>
      <h3>{p.nome}</h3>
    </div>
  </header>
  {(p.chamada || p.descricao) && <p class="sp-desc">{variant === 'mini' ? (p.chamada || p.descricao) : p.descricao || p.chamada}</p>}
  {p.cupom && (
    <div class="sp-cupom">
      <span>Cupom</span>
      <code>{p.cupom}</code>
      <button type="button" class="sp-copy" data-copy={p.cupom} aria-label={`Copiar cupom ${p.cupom}`}>Copiar</button>
    </div>
  )}
  <div class="sp-foot">
    {p.link && <a class="btn sp-btn" href={p.link} target="_blank" rel="sponsored noopener">{p.botao || 'Ver oferta'} <span aria-hidden="true">↗</span></a>}
    {svg && <figure class="sp-qr"><Fragment set:html={svg} /><figcaption>Aponte a câmera</figcaption></figure>}
  </div>
  {showVideos && p.videos.length > 0 && (
    <p class="sp-vistos">Citado em {p.videos.length} vídeo{p.videos.length > 1 ? 's' : ''} recente{p.videos.length > 1 ? 's' : ''}: {p.videos.slice(0, 3).map((v, i) => <Fragment>{i > 0 && ', '}<a href={href(`v/${v.id}/`)}>{v.title.length > 48 ? v.title.slice(0, 46) + '…' : v.title}</a></Fragment>)}</p>
  )}
</article>
