---
/* Links sociais do canal e do Felipe. `btn` troca o chip circular por botão de texto. */
const { item, btn = false, gold = false } = Astro.props;
const label = `${item.label}: ${item.handle}`;
---
{btn ? (
  <a class:list={['btn', gold && 'btn-gold']} href={item.url} target="_blank" rel="noopener me">
    {item.id === 'youtube' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M22 12s0-3.5-.5-5.1a2.9 2.9 0 0 0-2-2C17.9 4.5 12 4.5 12 4.5s-5.9 0-7.5.4a2.9 2.9 0 0 0-2 2C2 8.5 2 12 2 12s0 3.5.5 5.1a2.9 2.9 0 0 0 2 2c1.6.4 7.5.4 7.5.4s5.9 0 7.5-.4a2.9 2.9 0 0 0 2-2c.5-1.6.5-5.1.5-5.1zM10 15.5v-7l6 3.5z"/></svg>}
    {item.id === 'instagram' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>}
    {item.id === 'x' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>}
    {item.label} — {item.handle}
  </a>
) : (
  <a class="soc" href={item.url} target="_blank" rel="noopener me" aria-label={label} title={label}>
    {item.id === 'youtube' && <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M22 12s0-3.5-.5-5.1a2.9 2.9 0 0 0-2-2C17.9 4.5 12 4.5 12 4.5s-5.9 0-7.5.4a2.9 2.9 0 0 0-2 2C2 8.5 2 12 2 12s0 3.5.5 5.1a2.9 2.9 0 0 0 2 2c1.6.4 7.5.4 7.5.4s5.9 0 7.5-.4a2.9 2.9 0 0 0 2-2c.5-1.6.5-5.1.5-5.1zM10 15.5v-7l6 3.5z"/></svg>}
    {item.id === 'instagram' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>}
    {item.id === 'x' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>}
  </a>
)}
