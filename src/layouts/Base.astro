---
import '../styles/global.css';
import Social from '../components/Social.astro';
import { site, updated } from '../lib/data.mjs';
import { href, fmtDate } from '../lib/format.mjs';
import { t, altLocales, unprefix } from '../lib/i18n.mjs';

interface Props {
  title?: string;
  desc?: string;
  image?: string;
  ogType?: string;
  nav?: string;
  noindex?: boolean;
  locale?: string;
}
const { title = '', desc = '', image = '', ogType = 'website', nav = '', noindex = false, locale = 'pt' } = Astro.props;
const T = (k: string, v?: Record<string, string>) => t(locale, k, v);
const L = (p = '') => href(p, locale);
const full = title ? `${title} — ${site.name}` : `${site.name} — ${T('site_tagline')}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const canonicalPt = new URL(unprefix(Astro.url.pathname), Astro.site).href;
const htmlLang = locale === 'pt' ? 'pt-BR' : locale;
const ogLocale = locale === 'pt' ? 'pt_BR' : locale === 'en' ? 'en_US' : 'es_ES';
const links = [
  ['videos/', T('nav_videos'), 'videos'],
  ['categoria/lives/', T('nav_lives'), 'lives'],
  ['canais/', T('nav_canais'), 'canais'],
  ['parceiros/', T('nav_parceiros'), 'parceiros'],
  ['sobre/', T('nav_sobre'), 'sobre'],
];
const icons = {
  home: 'M12 3 3 10v11h6v-6h6v6h6V10z',
  videos: 'M4 5h16v14H4zm6 3v8l6-4z',
  busca: 'M10 3a7 7 0 0 1 5.6 11.2l4.6 4.6-1.4 1.4-4.6-4.6A7 7 0 1 1 10 3m0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10',
  canais: 'M7 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8m10 0a3 3 0 1 1 0-6 3 3 0 0 1 0 6M1 20c0-3.3 2.7-6 6-6s6 2.7 6 6zm13 0c0-1.9-.7-3.7-1.9-5 1.2-.6 2.5-1 3.9-1 3.3 0 6 2.2 6 5v1z',
};
const tabs = [['', T('tab_home'), 'home', ''], ['videos/', T('tab_videos'), 'videos', 'videos'], ['busca/', T('tab_search'), 'busca', 'busca'], ['canais/', T('tab_canais'), 'canais', 'canais']];
const langs = altLocales(Astro.url.pathname);
---
<!doctype html>
<html lang={htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{full}</title>
<meta name="description" content={desc || T('site_desc')}>
<link rel="canonical" href={canonical}>
{langs.map(a => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, Astro.site).href}>)}
<link rel="alternate" hreflang="x-default" href={canonicalPt}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0b0b0f">
<link rel="icon" href={href('favicon.svg')} type="image/svg+xml">
<link rel="manifest" href={href('manifest.webmanifest')}>
<link rel="alternate" type="application/rss+xml" title={site.name} href={L(locale === 'pt' ? 'feed.xml' : `feed-${locale}.xml`)}>
<link rel="preconnect" href="https://i.ytimg.com">
<meta property="og:site_name" content={site.name}>
<meta property="og:locale" content={ogLocale}>
{langs.map(a => <meta property="og:locale:alternate" content={{ pt: 'pt_BR', en: 'en_US', es: 'es_ES' }[a.locale]}>)}
<meta property="og:title" content={title || site.name}>
<meta property="og:description" content={desc || T('site_desc')}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
{image && <meta property="og:image" content={new URL(image, Astro.site).href}>}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: canonicalPt, inLanguage: htmlLang, publisher: { '@type': 'Organization', name: site.name, url: canonicalPt, logo: new URL(L('logo.svg'), Astro.site).href } }).replace(/</g, '\\u003c')} />
<slot name="head" />
</head>
<body>
<a class="skip" href="#conteudo">{T('skip_link')}</a>
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={L()} aria-label={T('brand_home')}>
      <img src={href('logo.svg')} width="36" height="36" alt="">
      <span><strong>EU VIM DE SANTOS</strong><small>{T('brand_tag')}</small></span>
    </a>
    <nav class="menu" aria-label={T('menu_label')}>
      {links.map(([p, label, key]) => <a href={L(p)} aria-current={nav === key ? 'page' : undefined}>{label}</a>)}
    </nav>
    <form class="busca" action={L('busca/')} role="search">
      <label class="sr" for="q-top">{T('search_label')}</label>
      <input id="q-top" name="q" type="search" placeholder={T('search_ph')} autocomplete="off">
      <button type="submit" aria-label={T('search_label')}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={icons.busca} /></svg></button>
    </form>
    <a class="btn-sub" href={`https://www.youtube.com/${site.channelHandle}?sub_confirmation=1`} target="_blank" rel="noopener">{T('subscribe')}</a>
    <nav class="langs" aria-label="Language / Idioma">
      {langs.map(a => <a href={a.href} hreflang={a.locale}>{a.locale}</a>)}
    </nav>
    <details class="mnav">
      <summary aria-label={T('menu_label')}><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span></summary>
      <nav aria-label={T('menu_label')}>
        {links.map(([p, label, key]) => <a class="mlink" href={L(p)} aria-current={nav === key ? 'page' : undefined}>{label}</a>)}
        <a class="btn btn-gold m-cta" href={`https://www.youtube.com/${site.channelHandle}?sub_confirmation=1`} target="_blank" rel="noopener">{T('subscribe_channel')}</a>
        <div class="m-soc">
          <span>{T('menu_follow')}</span>
          <div class="soc-row">
            {(site.social?.canal || []).map(s => <Social item={s} />)}
            {(site.social?.autor || []).map(s => <Social item={s} />)}
          </div>
        </div>
      </nav>
    </details>
  </div>
</header>
<main id="conteudo">
  <slot />
</main>
<footer class="foot">
  <div class="wrap foot-in">
    <div>
      <strong>{site.name}</strong>
      <p>{T('foot_fan', { a: site.author })}</p>
    </div>
    <nav aria-label={T('menu_label')}>
      <a href={L('videos/')}>{T('foot_archive')}</a>
      <a href={L('boletins/')}>{T('foot_boletins')}</a>
      <a href={L('canais/')}>{T('foot_canais')}</a>
      <a href={L('parceiros/')}>{T('foot_parceiros')}</a>
      <a href={L('sobre/#remocao')}>{T('foot_legal')}</a>
      <a href={L(locale === 'pt' ? 'feed.xml' : `feed-${locale}.xml`)}>{T('foot_rss')}</a>
      <a href={site.repoUrl} rel="noopener">{T('foot_source')}</a>
    </nav>
    <div class="foot-soc">
      <div>
        <h3>Eu Vim de Santos</h3>
        <div class="soc-row">{(site.social?.canal || []).map(s => <Social item={s} />)}</div>
        <small>{(site.social?.canal || []).map(s => s.handle).join(' · ')}</small>
      </div>
      <div>
        <h3>Felipe Noronha</h3>
        <div class="soc-row">{(site.social?.autor || []).map(s => <Social item={s} />)}</div>
        <small>{(site.social?.autor || []).map(s => s.handle).join(' · ')}</small>
      </div>
    </div>
  </div>
  <p class="wrap foot-upd">{T('foot_updated', { d: fmtDate(updated, { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }, locale) })}</p>
</footer>
<nav class="tabbar" aria-label={T('tab_label')}>
  {tabs.map(([p, label, ic, key]) => (
    <a href={L(p)} aria-current={nav === key || (!key && !nav) ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={icons[ic]} /></svg>{label}
    </a>
  ))}
</nav>
<script>
  // Interações mínimas: player sob demanda, trilhos, copiar link, horários da transcrição.
  const embed = (box: HTMLElement, start = 0) => {
    const id = box.dataset.id;
    box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start ? `&start=${start}` : ''}" title="${box.dataset.title || 'Vídeo'}" allow="accelerometer;autoplay;encrypted-media;picture-in-picture;web-share" allowfullscreen></iframe>`;
  };
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const lite = t.closest<HTMLElement>('.player .lite');
    if (lite && !(e as MouseEvent).ctrlKey && !(e as MouseEvent).metaKey) {
      e.preventDefault();
      embed(lite.parentElement as HTMLElement);
      return;
    }
    const ts = t.closest<HTMLElement>('a.ts');
    const box = document.querySelector<HTMLElement>('.video .player');
    if (ts && box) {
      e.preventDefault();
      embed(box, Number(ts.dataset.t) || 0);
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    const cp = t.closest<HTMLButtonElement>('[data-copy]');
    if (cp) {
      const txt = cp.dataset.copy || location.href;
      const lang = (document.documentElement.lang || 'pt').slice(0, 2);
      const msg = {
        pt: ['Copiado ✓', 'Não copiou — tente de novo'],
        en: ['Copied ✓', 'Copy failed — try again'],
        es: ['Copiado ✓', 'No se copió — intenta de nuevo'],
      }[lang] || ['Copiado ✓', 'Não copiou — tente de novo'];
      const done = (ok: boolean) => {
        const old = cp.textContent;
        cp.textContent = ok ? msg[0] : msg[1];
        setTimeout(() => (cp.textContent = old), 1800);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(txt).then(() => done(true), () => done(false));
      } else {
        // fallback para navegadores sem Clipboard API (HTTP, webviews antigas)
        const ta = document.createElement('textarea');
        ta.value = txt;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { done(document.execCommand('copy')); } catch { done(false); }
        ta.remove();
      }
    }
  });
  // âncora para <details> fechado (ex.: /boletins/ → #boletim): abre ao chegar
  if (location.hash.length > 1) {
    const dh = document.querySelector(location.hash);
    if (dh?.tagName === 'DETAILS') (dh as HTMLDetailsElement).open = true;
  }
  // menu móvel: fecha ao clicar fora, com Escape ou ao trocar de estado
  const mnav = document.querySelector<HTMLDetailsElement>('.mnav');
  const msummary = mnav?.querySelector('summary');
  if (mnav && msummary) {
    msummary.setAttribute('aria-expanded', 'false');
    mnav.addEventListener('toggle', () => msummary.setAttribute('aria-expanded', String(mnav.open)));
    document.addEventListener('click', (e) => {
      if (mnav.open && !mnav.contains(e.target as Node)) mnav.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') mnav.open = false;
    });
  }
  if (matchMedia('(hover: hover) and (min-width: 861px)').matches) {
    document.querySelectorAll<HTMLElement>('.rail').forEach((rail) => {
      const track = rail.querySelector<HTMLElement>('.rail-track');
      const nav = rail.querySelector<HTMLElement>('.rail-nav');
      if (!track || !nav || track.scrollWidth <= track.clientWidth + 4) return;
      nav.hidden = false;
      const [prev, next] = nav.querySelectorAll('button');
      const sync = () => {
        prev.disabled = track.scrollLeft < 8;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      };
      nav.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button');
        if (b) track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.9, behavior: 'smooth' });
      });
      track.addEventListener('scroll', sync, { passive: true });
      sync();
    });
  }
</script>
</body>
</html>
