---
import Base from '../layouts/Base.astro';
import { canais, now } from '../lib/data.mjs';
import { thumb, compact, ago } from '../lib/format.mjs';
---
<Base title="Canais indicados" desc="Canais santistas indicados pelo Eu Vim de Santos." nav="canais">
  <div class="wrap page">
    <header class="page-h"><h1>Canais indicados</h1><p>Outros canais santistas que valem a inscrição. Os últimos vídeos de cada um aparecem aqui automaticamente.</p></header>
    {canais.length === 0 && <p class="vazio">Os canais aparecem aqui na próxima atualização automática.</p>}
    {canais.map(c => {
      const latest = (c.latest || []).filter(x => !x.short).slice(0, 10);
      return (
        <section class="canal">
          <header class="canal-h">
            {c.avatar ? <img src={c.avatar} alt="" width="88" height="88" loading="lazy"> : <span class="avatar-ph big">{(c.title || c.handle).replace('@', '')[0]}</span>}
            <div>
              <h2>{c.title || c.handle}</h2>
              <p class="canal-k">{c.handle}{c.subs ? ` · ${compact(c.subs)} inscritos` : ''}{c.videos ? ` · ${compact(c.videos)} vídeos` : ''}</p>
              {c.nota && <p>{c.nota}</p>}
            </div>
            <a class="btn btn-gold" href={`https://www.youtube.com/${c.handle}?sub_confirmation=1`} target="_blank" rel="noopener">Abrir canal</a>
          </header>
          {latest.length > 0 && (
            <div class="rail-track">
              {latest.map(x => (
                <a class="card" href={`https://www.youtube.com/watch?v=${x.id}`} target="_blank" rel="noopener">
                  <span class="thumb"><img src={thumb(x.id)} alt="" width="320" height="180" loading="lazy" decoding="async"></span>
                  <span class="card-body"><span class="kicker">{ago(x.published, now)}</span><span class="card-title">{x.title}</span>{x.views > 0 && <span class="card-meta">{compact(x.views)} views</span>}</span>
                </a>
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>
</Base>
