---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import ShortCard from '../components/ShortCard.astro';
import Rail from '../components/Rail.astro';
import Player from '../components/Player.astro';
import { videos, longs, shorts, canais, catList, CATS, transcribed, now } from '../lib/data.mjs';
import { href, thumbHq, ytUrl, kicker, compact, fmtSecs, fmtDate } from '../lib/format.mjs';

const hero = longs[0];
const upcoming = videos.find(v => v.upcoming);
const rest = longs.slice(1);
const month = longs.filter(v => now - +new Date(v.published) < 30 * 864e5);
const top = [...month].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 10);
const cats = catList.filter(c => c !== 'shorts').map(c => [c, rest.filter(v => v.cat === c).slice(0, 16)]).filter(([, l]) => l.length);
---
<Base image={hero ? thumbHq(hero.id) : ''}>
  {upcoming && (
    <a class="aovivo" href={ytUrl(upcoming)} target="_blank" rel="noopener"><span class="dot"></span><b>Ao vivo / agendado:</b> {upcoming.title} <span aria-hidden="true">›</span></a>
  )}
  {hero && (
    <section class="hero wrap">
      <Player v={hero} eager />
      <div class="hero-tx">
        <p class="hero-k"><span class="pill">Novo</span> {kicker(hero, now)}</p>
        <h1><a href={href(`v/${hero.id}/`)}>{hero.title}</a></h1>
        <p class="hero-meta">{[hero.views && `${compact(hero.views)} views`, hero.secs && fmtSecs(hero.secs), fmtDate(hero.published)].filter(Boolean).join(' · ')}</p>
        {hero.desc && <p class="hero-desc">{hero.desc.split('\n')[0].slice(0, 220)}</p>}
        <p class="hero-cta">
          <a class="btn btn-gold" href={href(`v/${hero.id}/`)}>Abrir página do vídeo</a>
          {transcribed.has(hero.id) && <a class="btn" href={href(`v/${hero.id}/#transcricao`)}>Ler transcrição</a>}
        </p>
      </div>
    </section>
  )}
  <div class="wrap">
    <Rail title="Mais recentes" link={href('videos/')}>{rest.slice(0, 16).map((v, i) => <Card v={v} eager={i < 4} />)}</Rail>
    {top.length >= 5 && <Rail title="Mais vistos do mês">{top.map(v => <Card v={v} />)}</Rail>}
    {cats.map(([c, list], i) => (
      <Fragment>
        <Rail title={CATS[c]} link={href(`categoria/${c}/`)}>{list.map(v => <Card v={v} />)}</Rail>
        {i === 0 && shorts.length > 0 && <Rail title="Em um minuto" link={href('categoria/shorts/')} cls="rail-shorts">{shorts.slice(0, 20).map(v => <ShortCard v={v} />)}</Rail>}
      </Fragment>
    ))}
    {canais.length > 0 && (
      <section class="rail">
        <div class="rail-h"><h2>Canais indicados</h2><a href={href('canais/')}>Ver canais <span aria-hidden="true">›</span></a></div>
        <div class="canais-mini">
          {canais.map(c => (
            <a class="canal-mini" href={`https://www.youtube.com/${c.handle}`} target="_blank" rel="noopener">
              {c.avatar ? <img src={c.avatar} alt="" width="56" height="56" loading="lazy"> : <span class="avatar-ph">{(c.title || c.handle).replace('@', '')[0]}</span>}
              <span><strong>{c.title || c.handle}</strong><small>{c.handle}{c.subs ? ` · ${compact(c.subs)} inscritos` : ''}</small></span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
