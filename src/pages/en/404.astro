---
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/format.mjs';
import { t } from '../../lib/i18n.mjs';
const locale = 'en';
---
<Base title={t(locale, 'nf_title')} noindex locale={locale}>
  <div class="wrap page nf">
    <p class="nf-k">404</p>
    <h1>{t(locale, 'nf_h1')}</h1>
    <p>{t(locale, 'nf_p')}</p>
    <p><a class="btn btn-gold" href={href('', locale)}>{t(locale, 'nf_home')}</a> <a class="btn" href={href('videos/', locale)}>{t(locale, 'nf_archive')}</a></p>
  </div>
</Base>
